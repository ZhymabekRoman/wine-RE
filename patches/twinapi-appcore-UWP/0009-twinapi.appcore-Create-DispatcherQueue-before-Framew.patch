From fec4ec753bfafe5f63200048bacaf510bffbe4b6 Mon Sep 17 00:00:00 2001
From: Zhymabek Roman <s.salkimbaev@abaiuniversity.edu.kz>
Date: Mon, 15 Jun 2026 00:46:31 +0500
Subject: [PATCH 9/9] twinapi.appcore: Create DispatcherQueue before
 FrameworkView.Initialize
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The real CoreApplication.Run creates a DispatcherQueue (via
WinUICreateDispatcherQueueController) BEFORE calling FrameworkView.Initialize.
The DispatcherQueue drives the composition tick (CCoreServices::Tick →
DCompTreeHost → CreateConversationHost) that creates the CoreUI
ConversationServer — the dispatch handler at endpoint+0x58. Without it the
first CoreUI message dispatches against an empty table → AV.

Add WinUICreateDispatcherQueueController(opts={dwSize=12,threadType=1,apartment=2},
&controller) call before CreateView/Initialize.

BREAKTHROUGH: WhatsApp now runs past Application.Start without crashing on the
main thread (55s timeout = alive). The secondary registrar-thread AV (013c) is
a separate issue.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 dlls/twinapi.appcore/core_application.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/dlls/twinapi.appcore/core_application.c b/dlls/twinapi.appcore/core_application.c
index e7c7d76..36ecbd5 100644
--- a/dlls/twinapi.appcore/core_application.c
+++ b/dlls/twinapi.appcore/core_application.c
@@ -393,11 +393,31 @@ static HRESULT WINAPI core_application_Run( ICoreApplication *iface, IFrameworkV
     ICoreApplicationView *app_view;
     IFrameworkView *view;
     HRESULT hr;
+    HMODULE cm;
 
     FIXME( "iface %p, view_source %p semi-stub.\n", iface, view_source );
 
     if (!view_source) return E_INVALIDARG;
 
+    /* Create the DispatcherQueue BEFORE FrameworkView.Initialize — the real
+     * CoreApplication.Run does this. The DispatcherQueue drives the composition
+     * tick (CCoreServices::Tick → DCompTreeHost → CreateConversationHost) that
+     * creates the CoreUI ConversationServer (the dispatch handler at endpoint+0x58).
+     * Without it the first CoreUI message dispatches against an empty table → AV. */
+    if ((cm = GetModuleHandleW( L"CoreMessagingXP.dll" )))
+    {
+        HRESULT (WINAPI *p_create_dqc)(void *, IInspectable **) =
+            (void *)GetProcAddress( cm, "WinUICreateDispatcherQueueController" );
+        if (p_create_dqc)
+        {
+            /* DispatcherQueueOptions { dwSize=12, threadType=1(CURRENT_THREAD), apartment=2(MTA) } */
+            struct { DWORD dwSize; DWORD threadType; DWORD apartment; } opts = { 12, 1, 2 };
+            IInspectable *dqc = NULL;
+            HRESULT dqhr = p_create_dqc( &opts, &dqc );
+            FIXME( "DispatcherQueueController hr=%#lx obj=%p\n", dqhr, dqc );
+        }
+    }
+
     if (FAILED(hr = IFrameworkViewSource_CreateView( view_source, &view )))
     {
         ERR( "CreateView failed %#lx.\n", hr );
-- 
