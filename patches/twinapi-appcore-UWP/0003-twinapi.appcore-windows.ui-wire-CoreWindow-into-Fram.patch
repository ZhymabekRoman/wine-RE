+
+struct core_dispatcher
+{
+    ICoreDispatcher ICoreDispatcher_iface;
+    LONG ref;
+};
+
+static inline struct core_dispatcher *impl_from_ICoreDispatcher( ICoreDispatcher *iface )
+{
