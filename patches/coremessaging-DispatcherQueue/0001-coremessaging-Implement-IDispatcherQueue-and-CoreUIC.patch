 dlls/coremessaging/main.c             | 235 +++++++++++++++++++++++++-
 2 files changed, 231 insertions(+), 6 deletions(-)

diff --git a/dlls/coremessaging/coremessaging.spec b/dlls/coremessaging/coremessaging.spec
