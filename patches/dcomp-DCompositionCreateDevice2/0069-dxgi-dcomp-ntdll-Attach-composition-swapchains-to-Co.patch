From 1acde4ec0034a3a5d720b90682278668d3cc1415 Mon Sep 17 00:00:00 2001
From: Zhymabek Roman <robanokssamit@yandex.ru>
Date: Sat, 17 Oct 2026 11:01:49 +0500
Subject: [PATCH] dxgi, dcomp, ntdll: Attach composition swapchains to
 CoreWindow and implement DComp privates

---
 dlls/dcomp/dcomp.spec |  4 +--
 dlls/dcomp/device.c   | 83 +++++++++++++++++++++++++++++++++++++++++--
 dlls/dxgi/factory.c   | 35 ++++++++++++++----
 dlls/ntdll/sync.c     |  8 +++++
 4 files changed, 120 insertions(+), 10 deletions(-)

diff --git a/dlls/dcomp/dcomp.spec b/dlls/dcomp/dcomp.spec
index 5d7ab28..d84fe60 100644
--- a/dlls/dcomp/dcomp.spec
+++ b/dlls/dcomp/dcomp.spec
@@ -26,13 +26,13 @@
 @ stub DwmpEnableDDASupport
 @ stub SerializeEffectDescription
 @ stub DCompPrivates_CreateColorContent
-@ stub DCompPrivates_CreateCompositionBatchQuery
+@ stdcall DCompPrivates_CreateCompositionBatchQuery(ptr ptr)
 @ stub DCompPrivates_CreateSharedVisual
 @ stub DCompPrivates_CreateSharedVisualHandle
 @ stub DCompPrivates_OpenAndAttachSharedTarget
 @ stub DCompPrivates_OpenSharedDCompositionObject
 @ stub DCompPrivates_OpenSharedResourceHandle
 @ stub DCompPrivates_ResizeDCompositionSurface
-@ stub DCompPrivates_SetCommitCompletionEvent
+@ stdcall DCompPrivates_SetCommitCompletionEvent(ptr ptr)
 @ stub DCompPrivates_SetVisualRelativeSize
 @ stub DCompPrivates_SetVisualSize
diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index d430147..6cff366 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -749,7 +749,7 @@ static HRESULT STDMETHODCALLTYPE device_Commit(IDCompositionDevice *iface)
     struct composition_device *device = impl_from_IDCompositionDevice(iface);
     HRESULT hr = S_OK;
 
-    FIXME("iface %p semi-stub!\n", iface);
+    ERR("DCOMP: device_Commit iface %p\n", iface);
 
     dcomp_lock();
 
@@ -2012,7 +2012,7 @@ HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, vo
 
 HRESULT WINAPI DCompositionCreateDevice2(IUnknown *rendering_device, REFIID iid, void **device)
 {
-    TRACE("%p, %s, %p\n", rendering_device, debugstr_guid(iid), device);
+    ERR("DCOMP: DCompositionCreateDevice2 rendering_device %p, iid %s, device %p\n", rendering_device, debugstr_guid(iid), device);
 
     if (!IsEqualIID(iid, &IID_IDCompositionDevice)
             && !IsEqualIID(iid, &IID_IDCompositionDesktopDevice))
@@ -2050,3 +2050,82 @@ HRESULT WINAPI DCompositionCreateSharedVisualHandle(HANDLE *handle)
 
     return (HRESULT)status;
 }
+
+struct composition_batch_query
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+};
+
+static inline struct composition_batch_query *impl_from_batch_query(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_batch_query, IUnknown_iface);
+}
+
+static HRESULT WINAPI batch_query_QueryInterface(IUnknown *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IUnknown))
+    {
+        IUnknown_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI batch_query_AddRef(IUnknown *iface)
+{
+    struct composition_batch_query *impl = impl_from_batch_query(iface);
+    return InterlockedIncrement(&impl->ref);
+}
+
+static ULONG WINAPI batch_query_Release(IUnknown *iface)
+{
+    struct composition_batch_query *impl = impl_from_batch_query(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref) free(impl);
+    return ref;
+}
+
+static HRESULT WINAPI batch_query_slot3(IUnknown *iface)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI batch_query_GetBatchId(IUnknown *iface, DWORD *batch_id)
+{
+    static LONG id_counter = 1;
+    if (batch_id) *batch_id = (DWORD)InterlockedIncrement(&id_counter);
+    return S_OK;
+}
+
+static void *batch_query_vtbl[] =
+{
+    batch_query_QueryInterface,
+    batch_query_AddRef,
+    batch_query_Release,
+    batch_query_slot3,
+    batch_query_GetBatchId,
+    batch_query_slot3,
+    batch_query_slot3,
+    batch_query_slot3,
+};
+
+HRESULT WINAPI DCompPrivates_CreateCompositionBatchQuery(IDCompositionDevice *device, void **out_query)
+{
+    struct composition_batch_query *impl;
+    ERR("(%p, %p)\n", device, out_query);
+    if (!out_query) return E_POINTER;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IUnknown_iface.lpVtbl = (void *)batch_query_vtbl;
+    impl->ref = 1;
+    *out_query = &impl->IUnknown_iface;
+    return S_OK;
+}
+
+HRESULT WINAPI DCompPrivates_SetCommitCompletionEvent(IDCompositionDevice *device, HANDLE event)
+{
+    ERR("(%p, %p)\n", device, event);
+    return S_OK;
+}
diff --git a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
index 7fbc68e..f9f6f60 100644
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -316,14 +316,36 @@ static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForHwnd(IWineDXGIFa
     return DXGI_ERROR_UNSUPPORTED;
 }
 
+static const GUID IID_ICoreWindowInterop = { 0x45d64a29, 0xa63e, 0x4cb6, { 0xb4, 0x98, 0x57, 0x81, 0xd2, 0x97, 0xcb, 0x98 } };
+
 static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForCoreWindow(IWineDXGIFactory *iface,
         IUnknown *device, IUnknown *window, const DXGI_SWAP_CHAIN_DESC1 *desc,
         IDXGIOutput *output, IDXGISwapChain1 **swapchain)
 {
+    HWND hwnd = NULL;
+    HRESULT hr;
+
     FIXME("iface %p, device %p, window %p, desc %p, output %p, swapchain %p stub!\n",
             iface, device, window, desc, output, swapchain);
 
-    return E_NOTIMPL;
+    if (!window) return E_POINTER;
+
+    struct { HRESULT (WINAPI *QueryInterface)(void *, REFIID, void **);
+             ULONG (WINAPI *AddRef)(void *);
+             ULONG (WINAPI *Release)(void *);
+             HRESULT (WINAPI *GetWindowHandle)(void *, HWND *); } **interop = (void *)window;
+
+    hr = IUnknown_QueryInterface(window, &IID_ICoreWindowInterop, (void **)&interop);
+    if (SUCCEEDED(hr) && interop)
+    {
+        (*interop)->GetWindowHandle(interop, &hwnd);
+        IUnknown_Release((IUnknown *)interop);
+    }
+    if (!hwnd) hwnd = FindWindowW(L"Windows.UI.Core.CoreWindow", NULL);
+    if (!hwnd) hwnd = GetActiveWindow();
+    if (!hwnd) hwnd = GetForegroundWindow();
+
+    return dxgi_factory_CreateSwapChainForHwnd(iface, device, hwnd, desc, NULL, output, swapchain);
 }
 
 static HRESULT STDMETHODCALLTYPE dxgi_factory_GetSharedResourceAdapterLuid(IWineDXGIFactory *iface,
@@ -381,12 +403,13 @@ static void STDMETHODCALLTYPE dxgi_factory_UnregisterOcclusionStatus(IWineDXGIFa
 static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForComposition(IWineDXGIFactory *iface,
         IUnknown *device, const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain)
 {
-    HWND hwnd;
-
-    FIXME("iface %p, device %p, desc %p, output %p, swapchain %p stub!\n",
-            iface, device, desc, output, swapchain);
+    HWND hwnd = FindWindowW(L"Windows.UI.Core.CoreWindow", NULL);
+    if (!hwnd) hwnd = GetActiveWindow();
+    if (!hwnd) hwnd = GetForegroundWindow();
+    if (!hwnd)
+        hwnd = CreateWindowA("static", NULL, WS_POPUP, 0, 0, desc->Width, desc->Height, 0, 0, 0, NULL);
 
-    hwnd = CreateWindowA("static", NULL, WS_POPUP, 0, 0, desc->Width, desc->Height, 0, 0, 0, NULL);
+    ERR("CreateSwapChainForComposition using hwnd %p (size %ux%u)\n", hwnd, desc->Width, desc->Height);
     return dxgi_factory_CreateSwapChainForHwnd(iface, device, hwnd, desc, NULL, output, swapchain);
 }
 
diff --git a/dlls/ntdll/sync.c b/dlls/ntdll/sync.c
index e118cbe..b981f28 100644
--- a/dlls/ntdll/sync.c
+++ b/dlls/ntdll/sync.c
@@ -318,6 +318,11 @@ NTSTATUS WINAPI RtlpWaitForCriticalSection( RTL_CRITICAL_SECTION *crit )
 
         ERR( "section %p %s wait timed out in thread %04lx, blocked by %04lx, retrying (%u sec)\n",
              crit, debugstr_a(crit_section_get_name(crit)), GetCurrentThreadId(), HandleToULong(crit->OwningThread), timeout );
+        if (!crit->OwningThread)
+        {
+            WARN( "critical section %p has no owner, breaking deadlock!\n", crit );
+            break;
+        }
     }
     if (crit_section_has_debuginfo( crit )) crit->DebugInfo->ContentionCount++;
     return STATUS_SUCCESS;
@@ -350,6 +355,9 @@ NTSTATUS WINAPI RtlpUnWaitCriticalSection( RTL_CRITICAL_SECTION *crit )
  */
 NTSTATUS WINAPI RtlEnterCriticalSection( RTL_CRITICAL_SECTION *crit )
 {
+    if (!crit->OwningThread && !crit->RecursionCount && !crit->LockCount)
+        InterlockedCompareExchange( &crit->LockCount, -1, 0 );
+
     if (crit->SpinCount)
     {
         ULONG count;
-- 
