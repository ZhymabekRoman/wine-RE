From 9a85dae8c32ab4552e59547f6e71d08596b4bc33 Mon Sep 17 00:00:00 2001
From: Zhymabek Roman <robanokssamit@yandex.ru>
Date: Sat, 17 Oct 2026 14:17:16 +0500
Subject: [PATCH] dcomp: Fix CreateSurface AV and attach shared visual to
 CoreWindow target

---
 dlls/dcomp/device.c | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
index 4efb27d..a2853c6 100644
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -1052,7 +1052,6 @@ static HRESULT STDMETHODCALLTYPE desktop_device_CreateSurface(IDCompositionDevic
 {
     FIXME("iface %p, width %u, height %u, format %#x, alpha_mode %#x, surface %p stub!\n", iface,
             width, height, pixel_format, alpha_mode, surface);
-    if (surface) *surface = NULL;
     return E_NOTIMPL;
 }
 
@@ -1222,6 +1221,32 @@ static HRESULT STDMETHODCALLTYPE desktop_device_CreateFromSharedVisualHandle(IDC
         hr = create_visual_from_shared_visual_handle(visual_handle, out);
         FIXME("Created a IDCompositionVisual %p from a shared visual handle %p, hr %#lx.\n", *out,
               visual_handle, hr);
+        if (SUCCEEDED(hr) && out && *out)
+        {
+            struct composition_device *device = impl_from_IDCompositionDeviceUnknown(iface);
+            HWND hwnd = FindWindowW(L"Windows.UI.Core.CoreWindow", NULL);
+            if (!hwnd) hwnd = GetActiveWindow();
+            if (!hwnd) hwnd = GetForegroundWindow();
+            if (hwnd)
+            {
+                IDCompositionTarget *target = NULL;
+                create_target(device, hwnd, TRUE, &target);
+                if (target)
+                {
+                    struct composition_target *target_impl = impl_from_IDCompositionTarget(target);
+                    target_impl->root = (IDCompositionVisual *)*out;
+                    IDCompositionVisual_AddRef(target_impl->root);
+                    ERR("DCOMP: attached shared visual %p to target %p hwnd %p\n", *out, target, hwnd);
+                }
+            }
+            if (!device->thread || device->thread_exited)
+            {
+                device->thread_exited = FALSE;
+                device->exit_thread = FALSE;
+                device->thread = CreateThread(NULL, 0, composite_thread_proc, &device->IDCompositionDevice_iface, 0, NULL);
+                ERR("DCOMP: started composite_thread_proc %p\n", device->thread);
+            }
+        }
         return hr;
     }
     else if (IsEqualGUID(iid, &IID_IDCompositionTarget))
-- 
2.56.0

