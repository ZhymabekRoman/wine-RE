From 8d45849208e4aa75025d01094e10e7fe5fc5a989 Mon Sep 17 00:00:00 2001
From: Zhymabek Roman <s.salkimbaev@abaiuniversity.edu.kz>
Date: Sat, 13 Jun 2026 21:27:46 +0500
Subject: [PATCH 3/5] server/ntdll: ALPC post-accept message routing +
 PortContext/ClientId delivery

- Route client request messages to the server's listening port (where ALPC
  servers receive all connections' messages), and route server replies sent on
  the listening port back to the connected client.
- Carry per-message metadata (PortContext, ClientId, type) via a wire header so
  the receiver's PORT_MESSAGE.ClientId and the CONTEXT message attribute
  (PortContext) are populated as the kernel would.
- Plumb port_context through accept_alpc_connection.

CoreMessaging now completes connect -> impersonate -> accept -> request ->
reply; WhatsApp progresses through the full handshake into WinUI3 startup.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 dlls/ntdll/unix/alpc.c         |  78 +++++++++++++-----
 include/wine/server_protocol.h |   3 +-
 server/alpc.c                  | 140 ++++++++++++++++++++++++---------
 server/protocol.def            |   1 +
 server/request_handlers.h      |   3 +-
 server/request_trace.h         |   1 +
 6 files changed, 165 insertions(+), 61 deletions(-)

diff --git a/dlls/ntdll/unix/alpc.c b/dlls/ntdll/unix/alpc.c
index a6c65ae..40cdfe0 100644
--- a/dlls/ntdll/unix/alpc.c
+++ b/dlls/ntdll/unix/alpc.c
@@ -213,9 +213,10 @@ NTSTATUS WINAPI NtAlpcAcceptConnectPort( HANDLE *communication_port, HANDLE conn
 
     SERVER_START_REQ( accept_alpc_connection )
     {
-        req->server_port = wine_server_obj_handle( connection_port );
-        req->msg_id      = msg_id;
-        req->accept      = accept_connection;
+        req->server_port  = wine_server_obj_handle( connection_port );
+        req->msg_id       = msg_id;
+        req->accept       = accept_connection;
+        req->port_context = (client_ptr_t)(ULONG_PTR)port_context;
         ret = wine_server_call( req );
         if (!ret && accept_connection)
             *communication_port = wine_server_ptr_handle( reply->handle );
@@ -346,27 +347,64 @@ NTSTATUS WINAPI NtAlpcSendWaitReceivePort( HANDLE port_handle, DWORD flags,
 
     if (!ret && recv_buffer_size) *recv_buffer_size = io.Information;
 
-    /* Detect the wine-internal connect-notification blob
-     * { magic, msg_id, client_pid, client_tid, payload_size, payload... }
-     * and turn it into a proper LPC_CONNECTION_REQUEST PORT_MESSAGE in-place. */
-    if (!ret && recv_msg && io.Information >= 5 * sizeof(ULONG))
+    /* Every delivered message is prefixed by a wine-internal wire header
+     * { u32 magic,type,msg_id,pid,tid,user_size; u64 port_context }. Strip it and
+     * reconstruct the kernel-filled PORT_MESSAGE fields + CONTEXT attribute. */
+    if (!ret && recv_msg && io.Information >= 32)
     {
-        ULONG hdr[5];
-        memcpy( hdr, recv_msg, sizeof(hdr) );
-        if (hdr[0] == 0x434e4e41) /* 'ANNC' */
+        ULONG  h[6];
+        ULONGLONG port_context;
+        memcpy( h, recv_msg, sizeof(h) );
+        memcpy( &port_context, (char *)recv_msg + 24, sizeof(port_context) );
+        if (h[0] == 0x434e4e41) /* 'ANNC' */
         {
-            ULONG msg_id = hdr[1], pid = hdr[2], tid = hdr[3], payload = hdr[4];
-            char *src = (char *)recv_msg + 5 * sizeof(ULONG);
-
-            if (payload) memmove( (char *)recv_msg + sizeof(*recv_msg), src, payload );
-            memset( recv_msg, 0, sizeof(*recv_msg) );
-            recv_msg->DataLength  = payload;
-            recv_msg->TotalLength = sizeof(*recv_msg) + payload;
-            recv_msg->Type        = LPC_CONNECTION_REQUEST;
-            recv_msg->MessageId   = msg_id;
+            ULONG type = h[1], msg_id = h[2], pid = h[3], tid = h[4], usize = h[5];
+            char *src = (char *)recv_msg + 32;
+            SIZE_T total;
+
+            if (type == LPC_CONNECTION_REQUEST)
+            {
+                /* user bytes are the raw connection payload: build a PORT_MESSAGE */
+                if (usize) memmove( (char *)recv_msg + sizeof(*recv_msg), src, usize );
+                memset( recv_msg, 0, sizeof(*recv_msg) );
+                recv_msg->DataLength  = usize;
+                recv_msg->TotalLength = sizeof(*recv_msg) + usize;
+                recv_msg->Type        = LPC_CONNECTION_REQUEST;
+                recv_msg->MessageId   = msg_id;
+                total = sizeof(*recv_msg) + usize;
+            }
+            else
+            {
+                /* user bytes are the sender's full PORT_MESSAGE: preserve its
+                 * Type/MessageId/CallbackId (reply correlation), only stamp ClientId */
+                memmove( recv_msg, src, usize );
+                total = usize;
+            }
             recv_msg->ClientId.UniqueProcess = (HANDLE)(ULONG_PTR)pid;
             recv_msg->ClientId.UniqueThread  = (HANDLE)(ULONG_PTR)tid;
-            if (recv_buffer_size) *recv_buffer_size = sizeof(*recv_msg) + payload;
+            if (recv_buffer_size) *recv_buffer_size = total;
+
+            /* deliver the CONTEXT attribute (PortContext) the kernel would fill */
+            if (recv_msg_attr)
+            {
+                ULONG alloc = recv_msg_attr->AllocatedAttributes;
+                if (alloc & 0x20000000) /* ALPC_MESSAGE_CONTEXT_ATTRIBUTE */
+                {
+                    SIZE_T off = 8;
+                    if (alloc & 0x80000000) off += 24; /* ALPC_SECURITY_ATTR */
+                    if (alloc & 0x40000000) off += 32; /* ALPC_VIEW_ATTR */
+                    {
+                        ALPC_CONTEXT_ATTR *ctx =
+                            (ALPC_CONTEXT_ATTR *)((char *)recv_msg_attr + off);
+                        ctx->PortContext    = (void *)(ULONG_PTR)port_context;
+                        ctx->MessageContext = NULL;
+                        ctx->Sequence       = 0;
+                        ctx->MessageId      = msg_id;
+                        ctx->CallbackId     = 0;
+                    }
+                    recv_msg_attr->ValidAttributes |= 0x20000000;
+                }
+            }
         }
     }
 
diff --git a/include/wine/server_protocol.h b/include/wine/server_protocol.h
index e0e1b2c..916b5e2 100644
--- a/include/wine/server_protocol.h
+++ b/include/wine/server_protocol.h
@@ -6235,6 +6235,7 @@ struct accept_alpc_connection_request
     obj_handle_t        server_port;
     unsigned int        msg_id;
     int                 accept;
+    client_ptr_t        port_context;
 };
 struct accept_alpc_connection_reply
 {
@@ -7263,6 +7264,6 @@ union generic_reply
     struct cancel_wait_completion_packet_reply cancel_wait_completion_packet_reply;
 };
 
-#define SERVER_PROTOCOL_VERSION 945
+#define SERVER_PROTOCOL_VERSION 946
 
 #endif /* __WINE_WINE_SERVER_PROTOCOL_H */
diff --git a/server/alpc.c b/server/alpc.c
index 2a35e76..7e64039 100644
--- a/server/alpc.c
+++ b/server/alpc.c
@@ -50,17 +50,21 @@ struct alpc_message
     /* user data bytes follow */
 };
 
-/* wine-internal connect-notification blob delivered on the listening port:
- * { magic, msg_id, client_pid, client_tid, payload_size, payload... } */
-#define ALPC_CONNECT_MAGIC 0x434e4e41 /* 'ANNC' */
-struct alpc_connect_blob
+/* wine-internal header prefixed to every message delivered to a receiver so
+ * ntdll can reconstruct the kernel-filled PORT_MESSAGE fields (ClientId,
+ * MessageId) and the CONTEXT message attribute (PortContext). For a connection
+ * request the user bytes are the raw connect payload; for a data message they
+ * are the sender's full PORT_MESSAGE. */
+#define ALPC_WIRE_MAGIC 0x434e4e41 /* 'ANNC' */
+struct alpc_wire_hdr
 {
-    unsigned int magic;
-    unsigned int msg_id;
-    unsigned int client_pid;
-    unsigned int client_tid;
-    unsigned int payload_size;
-    /* payload bytes follow */
+    unsigned int     magic;
+    unsigned int     type;        /* LPC message type (10 = connection request) */
+    unsigned int     msg_id;
+    unsigned int     client_pid;
+    unsigned int     client_tid;
+    unsigned int     user_size;   /* bytes of user message following */
+    client_ptr_t     port_context;
 };
 
 /* A pending (not yet accepted) client connection. */
@@ -90,9 +94,13 @@ struct alpc_port
 
     /* Server port only */
     struct list         pending_conns; /* struct alpc_pending_conn */
+    struct list         connections;   /* accepted client-side ports (conn_entry) */
 
     /* Connection only */
     struct alpc_port   *peer;        /* peer connection endpoint, or NULL */
+    struct alpc_port   *listen_port; /* client side: the server's listening port */
+    client_ptr_t        port_context;/* server side: context passed to accept */
+    struct list         conn_entry;  /* client side: entry in listen_port->connections */
 };
 
 /* ---- Forward declarations ---- */
@@ -201,13 +209,20 @@ static void alpc_port_destroy( struct object *obj )
             if (pc->client_port) release_object( pc->client_port );            free( pc->conn_data );            free( pc );
         }
     }
-    else if (port->peer)
+    else
     {
-        async_wake_up( &port->peer->read_q, STATUS_PIPE_DISCONNECTED );
-        port->peer->peer = NULL;
-        port->peer = NULL;
+        if (port->peer)
+        {
+            async_wake_up( &port->peer->read_q, STATUS_PIPE_DISCONNECTED );
+            port->peer->peer = NULL;
+            port->peer = NULL;
+        }
+        /* client side: unlink from the listening port's connection list
+         * (safe even when not linked: conn_entry is list_init'd) */
+        list_remove( &port->conn_entry );
     }
 
+    if (port->listen_port) release_object( port->listen_port );
     if (port->fd) release_object( port->fd );
 }
 
@@ -265,12 +280,26 @@ static void alpc_fd_write( struct fd *fd, struct async *async, file_pos_t pos )
     struct alpc_message *msg;
     struct iosb *iosb;
 
-    if (port->is_server || !port->peer)
+    if (port->is_server)
+    {
+        /* Server replying on its listening port: route to the connected client.
+         * (single-connection correlation; multi-client would match by CallbackId) */
+        struct list *head = list_head( &port->connections );
+        if (!head)
+        {
+            set_error( STATUS_PIPE_DISCONNECTED );
+            return;
+        }
+        peer = LIST_ENTRY( head, struct alpc_port, conn_entry );
+    }
+    else if (!port->peer)
     {
         set_error( STATUS_PIPE_DISCONNECTED );
         return;
     }
-    peer = port->peer;
+    /* The client side delivers to the server's listening port (where the server
+     * receives all connections' messages); the server side replies to its peer. */
+    else peer = port->listen_port ? port->listen_port : port->peer;
 
     iosb = async_get_iosb( async );
     if (!iosb->in_data || !iosb->in_size)
@@ -280,18 +309,33 @@ static void alpc_fd_write( struct fd *fd, struct async *async, file_pos_t pos )
         return;
     }
 
-    msg = malloc( sizeof(*msg) + iosb->in_size );
-    if (!msg)
     {
-        release_object( iosb );
-        set_error( STATUS_NO_MEMORY );
-        return;
-    }
+        struct alpc_wire_hdr *hdr;
+        data_size_t blob_size = sizeof(*hdr) + iosb->in_size;
+        /* context the receiver sees: the connection's per-connection context
+         * (set at accept on the server-side endpoint). */
+        client_ptr_t ctx = port->listen_port ? port->peer->port_context : port->port_context;
 
-    msg->is_connect = 0;
-    msg->msg_id     = 0;
-    msg->data_size  = iosb->in_size;
-    memcpy( (char *)msg + sizeof(*msg), iosb->in_data, iosb->in_size );
+        if (!(msg = malloc( sizeof(*msg) + blob_size )))
+        {
+            release_object( iosb );
+            set_error( STATUS_NO_MEMORY );
+            return;
+        }
+        msg->is_connect = 0;
+        msg->msg_id     = 0;
+        msg->data_size  = blob_size;
+
+        hdr = (struct alpc_wire_hdr *)((char *)msg + sizeof(*msg));
+        hdr->magic        = ALPC_WIRE_MAGIC;
+        hdr->type         = 1; /* LPC_REQUEST/REPLY – distinguished by the user PORT_MESSAGE */
+        hdr->msg_id       = 0;
+        hdr->client_pid   = get_process_id( current->process );
+        hdr->client_tid   = get_thread_id( current );
+        hdr->user_size    = iosb->in_size;
+        hdr->port_context = ctx;
+        memcpy( hdr + 1, iosb->in_data, iosb->in_size );
+    }
 
     list_add_tail( &peer->msg_queue, &msg->entry );
     wake_up( &peer->obj, 0 );
@@ -310,11 +354,15 @@ static struct alpc_port *create_alpc_port_obj( int is_server )
 
     if (!(port = alloc_object( &alpc_port_ops ))) return NULL;
 
-    port->is_server = is_server;
-    port->peer      = NULL;
+    port->is_server   = is_server;
+    port->peer        = NULL;
+    port->listen_port = NULL;
+    port->port_context = 0;
     list_init( &port->msg_queue );
     init_async_queue( &port->read_q );
     list_init( &port->pending_conns );
+    list_init( &port->connections );
+    list_init( &port->conn_entry );
 
     port->fd = alloc_pseudo_fd( &alpc_fd_ops, &port->obj, opts );
     if (!port->fd)
@@ -329,8 +377,8 @@ static struct alpc_port *create_alpc_port_obj( int is_server )
 static int queue_connect_notification( struct alpc_port *server_port, struct alpc_pending_conn *pc )
 {
     struct alpc_message *msg;
-    struct alpc_connect_blob *blob;
-    data_size_t blob_size = sizeof(*blob) + pc->conn_data_size;
+    struct alpc_wire_hdr *hdr;
+    data_size_t blob_size = sizeof(*hdr) + pc->conn_data_size;
 
     if (!(msg = malloc( sizeof(*msg) + blob_size )))
     {
@@ -341,14 +389,16 @@ static int queue_connect_notification( struct alpc_port *server_port, struct alp
     msg->msg_id     = pc->msg_id;
     msg->data_size  = blob_size;
 
-    blob = (struct alpc_connect_blob *)((char *)msg + sizeof(*msg));
-    blob->magic        = ALPC_CONNECT_MAGIC;
-    blob->msg_id       = pc->msg_id;
-    blob->client_pid   = pc->client_pid;
-    blob->client_tid   = pc->client_tid;
-    blob->payload_size = pc->conn_data_size;
+    hdr = (struct alpc_wire_hdr *)((char *)msg + sizeof(*msg));
+    hdr->magic        = ALPC_WIRE_MAGIC;
+    hdr->type         = 10; /* LPC_CONNECTION_REQUEST */
+    hdr->msg_id       = pc->msg_id;
+    hdr->client_pid   = pc->client_pid;
+    hdr->client_tid   = pc->client_tid;
+    hdr->user_size    = pc->conn_data_size;
+    hdr->port_context = 0;
     if (pc->conn_data_size)
-        memcpy( blob + 1, pc->conn_data, pc->conn_data_size );
+        memcpy( hdr + 1, pc->conn_data, pc->conn_data_size );
 
     list_add_tail( &server_port->msg_queue, &msg->entry );
     wake_up( &server_port->obj, 0 );
@@ -378,11 +428,15 @@ DECL_HANDLER(create_alpc_port)
     if (get_error() != STATUS_OBJECT_NAME_EXISTS)
     {
         /* Newly created: initialize all fields */
-        port->is_server = 1;
-        port->peer      = NULL;
+        port->is_server   = 1;
+        port->peer        = NULL;
+        port->listen_port = NULL;
+        port->port_context = 0;
         list_init( &port->msg_queue );
         init_async_queue( &port->read_q );
         list_init( &port->pending_conns );
+        list_init( &port->connections );
+        list_init( &port->conn_entry );
         port->fd = alloc_pseudo_fd( &alpc_fd_ops, &port->obj, FILE_SYNCHRONOUS_IO_NONALERT );
         if (!port->fd)
         {
@@ -591,6 +645,14 @@ DECL_HANDLER(accept_alpc_connection)
     server_conn_port->peer  = (struct alpc_port *)grab_object( found->client_port );
     found->client_port->peer = (struct alpc_port *)grab_object( server_conn_port );
 
+    /* The server receives all client messages on its listening port, so route
+     * the client side's writes there. The server side replies to the client. */
+    found->client_port->listen_port = (struct alpc_port *)grab_object( server_port );
+    server_conn_port->port_context  = req->port_context;
+    found->client_port->port_context = req->port_context;
+    /* track the connection on the listening port for reply routing */
+    list_add_tail( &server_port->connections, &found->client_port->conn_entry );
+
     reply->handle = alloc_handle( current->process, server_conn_port,
                                    GENERIC_READ | GENERIC_WRITE | SYNCHRONIZE, 0 );
     release_object( server_conn_port );
diff --git a/server/protocol.def b/server/protocol.def
index 152a503..0b82b3c 100644
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -4325,6 +4325,7 @@ enum inproc_sync_type
     obj_handle_t        server_port;    /* server listening port handle */
     unsigned int        msg_id;         /* msg_id from the received connect notification */
     int                 accept;         /* 1 = accept, 0 = reject */
+    client_ptr_t        port_context;   /* per-connection context (returned in CONTEXT attr) */
 @REPLY
     obj_handle_t        handle;         /* server-side connection handle */
 @END
diff --git a/server/request_handlers.h b/server/request_handlers.h
index a701f07..e5be498 100644
--- a/server/request_handlers.h
+++ b/server/request_handlers.h
@@ -2411,7 +2411,8 @@ C_ASSERT( sizeof(struct connect_alpc_port_reply) == 16 );
 C_ASSERT( offsetof(struct accept_alpc_connection_request, server_port) == 12 );
 C_ASSERT( offsetof(struct accept_alpc_connection_request, msg_id) == 16 );
 C_ASSERT( offsetof(struct accept_alpc_connection_request, accept) == 20 );
-C_ASSERT( sizeof(struct accept_alpc_connection_request) == 24 );
+C_ASSERT( offsetof(struct accept_alpc_connection_request, port_context) == 24 );
+C_ASSERT( sizeof(struct accept_alpc_connection_request) == 32 );
 C_ASSERT( offsetof(struct accept_alpc_connection_reply, handle) == 8 );
 C_ASSERT( sizeof(struct accept_alpc_connection_reply) == 16 );
 C_ASSERT( offsetof(struct disconnect_alpc_port_request, handle) == 12 );
diff --git a/server/request_trace.h b/server/request_trace.h
index e5a713f..0727289 100644
--- a/server/request_trace.h
+++ b/server/request_trace.h
@@ -3553,6 +3553,7 @@ static void dump_accept_alpc_connection_request( const struct accept_alpc_connec
     fprintf( stderr, " server_port=%04x", req->server_port );
     fprintf( stderr, ", msg_id=%08x", req->msg_id );
     fprintf( stderr, ", accept=%d", req->accept );
+    dump_uint64( ", port_context=", &req->port_context );
 }
 
 static void dump_accept_alpc_connection_reply( const struct accept_alpc_connection_reply *req )
