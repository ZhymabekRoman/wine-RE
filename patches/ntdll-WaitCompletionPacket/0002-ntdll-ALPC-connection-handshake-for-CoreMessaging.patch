 dlls/ntdll/ntsyscalls.h | 626 ++++++++++++++++++++--------------------
 dlls/ntdll/unix/alpc.c  |  57 +++-
 include/winternl.h      |   1 +
 4 files changed, 366 insertions(+), 320 deletions(-)

