From da7e6368dd577dead868be456ecfbfdaa7f3299f Mon Sep 17 00:00:00 2001
From: Zhymabek Roman <robanokssamit@yandex.ru>
Date: Thu, 15 Oct 2026 17:00:56 +0500
Subject: [PATCH] ntdll/server: Implement ALPC Section Views and VIEW attribute
 propagation

---
 dlls/kernelbase/debug.c        |   8 +
 dlls/ntdll/ntdll.spec          |   8 +
 dlls/ntdll/ntsyscalls.h        | 644 +++++++++++++++++----------------
 dlls/ntdll/signal_arm64ec.c    |   4 +
 dlls/ntdll/tests/alpc.c        | 195 ++++++++++
 dlls/ntdll/unix/alpc.c         | 252 +++++++++++--
 dlls/wow64/struct32.h          |   1 +
 dlls/wow64/syscall.c           |  78 ++++
 include/wine/server_protocol.h |  13 +-
 include/winternl.h             |  10 +-
 server/alpc.c                  |  45 ++-
 server/protocol.def            |  11 +
 12 files changed, 911 insertions(+), 358 deletions(-)

diff --git a/dlls/kernelbase/debug.c b/dlls/kernelbase/debug.c
index 8656859..ab85cc3 100644
--- a/dlls/kernelbase/debug.c
+++ b/dlls/kernelbase/debug.c
@@ -545,6 +545,14 @@ static BOOL start_debugger( EXCEPTION_POINTERS *epointers, HANDLE event )
 
     format_exception_msg( epointers, buffer, sizeof(buffer) );
     MESSAGE( "wine: %s (thread %04lx), starting debugger...\n", buffer, GetCurrentThreadId() );
+    if (epointers && epointers->ContextRecord)
+    {
+        ULONG_PTR *sp = (ULONG_PTR *)epointers->ContextRecord->Rsp;
+        int i;
+        MESSAGE( "RIP=%p RSP=%p\n", (void *)epointers->ContextRecord->Rip, (void *)sp );
+        for (i = 0; i < 110; i++)
+            MESSAGE( "  stack[%02d] (%p) = %016Ix\n", i, &sp[i], sp[i] );
+    }
 
     InitializeObjectAttributes( &attr, &nameW, 0, 0, NULL );
     if (!NtOpenKey( &dbg_key, KEY_READ, &attr ))
