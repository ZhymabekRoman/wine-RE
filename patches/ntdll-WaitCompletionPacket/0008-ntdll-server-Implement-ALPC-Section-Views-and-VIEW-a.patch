+
+    if (!pNtAlpcCreatePort || !pNtAlpcConnectPort || !pNtAlpcAcceptConnectPort ||
+        !pNtAlpcSendWaitReceivePort || !pNtAlpcCreatePortSection ||
+        !pNtAlpcCreateSectionView || !pNtAlpcDeleteSectionView || !pNtAlpcDeletePortSection)
+    {
+        win_skip("ALPC functions are unavailable.\n");
+        return;
+    }
+
+    RtlInitUnicodeString(&port_name, L"\\BaseNamedObjects\\TestAlpcViewPort");
+    InitializeObjectAttributes(&obj_attr, &port_name, 0, NULL, NULL);
+    memset(&port_attr, 0, sizeof(port_attr));
+    port_attr.MaxMessageLength = 0x1000;
+
+    status = pNtAlpcCreatePort(&server_port, &obj_attr, &port_attr);
+    ok(status == STATUS_SUCCESS, "NtAlpcCreatePort failed: %#lx\n", status);
+
+    status = pNtAlpcConnectPort(&client_conn, &port_name, NULL, &port_attr, 0, NULL, NULL, NULL, NULL, NULL, NULL);
+    ok(status == STATUS_SUCCESS || status == STATUS_PENDING, "NtAlpcConnectPort failed: %#lx\n", status);
+
+    memset(&req_msg, 0, sizeof(req_msg));
+    req_size = sizeof(req_msg);
+    status = pNtAlpcSendWaitReceivePort(server_port, 0, NULL, NULL, &req_msg, &req_size, NULL, NULL);
+    ok(status == STATUS_SUCCESS, "Receive connect request failed: %#lx\n", status);
+
+    status = pNtAlpcAcceptConnectPort(&server_conn, server_port, 0, NULL, NULL, NULL, &req_msg, NULL, TRUE);
+    ok(status == STATUS_SUCCESS, "NtAlpcAcceptConnectPort failed: %#lx\n", status);
+
+    /* Create client section and view */
+    status = pNtAlpcCreatePortSection(client_conn, 0, NULL, 0x1000, &section, &actual_size);
+    ok(status == STATUS_SUCCESS, "NtAlpcCreatePortSection failed: %#lx\n", status);
+
+    memset(&client_view, 0, sizeof(client_view));
+    client_view.SectionHandle = section;
+    client_view.ViewSize = 0x1000;
+    status = pNtAlpcCreateSectionView(client_conn, 0, &client_view);
+    ok(status == STATUS_SUCCESS, "NtAlpcCreateSectionView failed: %#lx\n", status);
+    strcpy((char *)client_view.ViewBase, "alpc shared payload 12345");
+
+    /* Client sends message with ALPC_MESSAGE_VIEW_ATTRIBUTE */
+    {
+        char send_buf[sizeof(ALPC_PORT_MESSAGE) + 32];
+        ALPC_PORT_MESSAGE *send_msg = (ALPC_PORT_MESSAGE *)send_buf;
+        char send_attr_buf[256];
+        ALPC_MESSAGE_ATTRIBUTES *send_attr = (ALPC_MESSAGE_ATTRIBUTES *)send_attr_buf;
+        SIZE_T req_attr_size = 0;
+        ALPC_DATA_VIEW_ATTR *view_attr;
+
+        status = pAlpcInitializeMessageAttribute(ALPC_MESSAGE_VIEW_ATTRIBUTE, send_attr, sizeof(send_attr_buf), &req_attr_size);
+        ok(status == STATUS_SUCCESS, "AlpcInitializeMessageAttribute failed: %#lx\n", status);
+        view_attr = pAlpcGetMessageAttribute(send_attr, ALPC_MESSAGE_VIEW_ATTRIBUTE);
+        ok(view_attr != NULL, "Expected valid view attribute pointer\n");
+        view_attr->Flags = 0;
+        view_attr->SectionHandle = section;
+        view_attr->ViewBase = client_view.ViewBase;
+        view_attr->ViewSize = 0x1000;
+        send_attr->ValidAttributes |= ALPC_MESSAGE_VIEW_ATTRIBUTE;
+
+        memset(send_msg, 0, sizeof(*send_msg));
+        send_msg->DataLength = 0;
+        send_msg->TotalLength = sizeof(*send_msg);
+
+        status = pNtAlpcSendWaitReceivePort(client_conn, 0x20000 /* LPC_REQUEST */, send_msg, send_attr, NULL, NULL, NULL, NULL);
+        ok(status == STATUS_SUCCESS, "NtAlpcSendWaitReceivePort (send) failed: %#lx\n", status);
+    }
+
+    /* Server receives message with ALPC_MESSAGE_VIEW_ATTRIBUTE */
+    {
+        char recv_buf[sizeof(ALPC_PORT_MESSAGE) + 32];
+        ALPC_PORT_MESSAGE *recv_msg = (ALPC_PORT_MESSAGE *)recv_buf;
+        char recv_attr_buf[256];
+        ALPC_MESSAGE_ATTRIBUTES *recv_attr = (ALPC_MESSAGE_ATTRIBUTES *)recv_attr_buf;
+        SIZE_T req_attr_size = 0;
+        SIZE_T recv_sz = sizeof(recv_buf);
+        ALPC_DATA_VIEW_ATTR *recvd_view;
+
+        status = pAlpcInitializeMessageAttribute(ALPC_MESSAGE_VIEW_ATTRIBUTE | ALPC_MESSAGE_CONTEXT_ATTRIBUTE,
+                                                 recv_attr, sizeof(recv_attr_buf), &req_attr_size);
+        ok(status == STATUS_SUCCESS, "AlpcInitializeMessageAttribute failed: %#lx\n", status);
+
+        memset(recv_msg, 0, sizeof(*recv_msg));
+        status = pNtAlpcSendWaitReceivePort(server_port, 0, NULL, NULL, recv_msg, &recv_sz, recv_attr, NULL);
+        ok(status == STATUS_SUCCESS, "NtAlpcSendWaitReceivePort (receive) failed: %#lx\n", status);
+
+        ok(recv_attr->ValidAttributes & ALPC_MESSAGE_VIEW_ATTRIBUTE,
+           "Expected ALPC_MESSAGE_VIEW_ATTRIBUTE in ValidAttributes, got %#lx\n", recv_attr->ValidAttributes);
+        recvd_view = pAlpcGetMessageAttribute(recv_attr, ALPC_MESSAGE_VIEW_ATTRIBUTE);
+        ok(recvd_view != NULL, "Expected recvd_view != NULL\n");
+        if (recvd_view)
+        {
+            ok(recvd_view->ViewBase == client_view.ViewBase,
+               "Expected ViewBase %p, got %p\n", client_view.ViewBase, recvd_view->ViewBase);
+            ok(recvd_view->ViewSize == 0x1000,
+               "Expected ViewSize 0x1000, got %Ix\n", recvd_view->ViewSize);
+            ok(!strcmp((char *)recvd_view->ViewBase, "alpc shared payload 12345"),
+               "Received view content mismatch: %s\n", (char *)recvd_view->ViewBase);
+        }
+    }
+
+    /* Clean up */
+    pNtAlpcDeleteSectionView(client_conn, 0, client_view.ViewBase);
+    pNtAlpcDeletePortSection(client_conn, 0, section);
+    if (pNtAlpcDisconnectPort)
+    {
+        pNtAlpcDisconnectPort(client_conn, 0);
+        pNtAlpcDisconnectPort(server_conn, 0);
+    }
+    pNtClose(client_conn);
+    pNtClose(server_conn);
+    pNtClose(server_port);
+}
