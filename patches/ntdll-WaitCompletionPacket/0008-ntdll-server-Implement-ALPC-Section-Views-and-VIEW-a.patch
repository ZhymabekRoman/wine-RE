+static void test_AlpcMessageViewAttribute(void)
+{
+    UNICODE_STRING port_name;
+    OBJECT_ATTRIBUTES obj_attr;
+    ALPC_PORT_ATTRIBUTES port_attr;
+    HANDLE server_port = NULL, client_conn = NULL, server_conn = NULL;
+    HANDLE section = NULL;
