-NTSTATUS WINAPI NtAlpcAcceptConnectPort( HANDLE *communication_port, HANDLE connection_port,
-                                         DWORD flags, OBJECT_ATTRIBUTES *obj_attr,
-                                         ALPC_PORT_ATTRIBUTES *port_attr, void *port_context,
